# MAZ Core v0.6.4 - local-first llama-swap + llama.cpp
MAZ_TOKEN=change-me-before-first-run
MAZ_BIND=0.0.0.0
MAZ_PORT=8787

# Speech-to-text stays local on the PC.
MAZ_WHISPER_MODEL=base.en
MAZ_WHISPER_DEVICE=cpu
MAZ_WHISPER_COMPUTE=int8

# Local AI. The installer proves these routes before declaring READY.
MAZ_LOCAL_ENGINE=llama_swap
MAZ_LOCAL_RUNTIME=llamacpp
MAZ_LOCAL_API_URL=http://127.0.0.1:8790/v1
MAZ_LOCAL_HEALTH_URL=http://127.0.0.1:8790/health
MAZ_LOCAL_MODEL=maz-primary
MAZ_LOCAL_BACKUP_MODEL=maz-backup
MAZ_LOCAL_CONTEXT=8192
MAZ_LOCAL_MAX_TOKENS=512
MAZ_LOCAL_TEMPERATURE=0.15
MAZ_LLAMACPP_PRIMARY_PATH=
MAZ_LLAMACPP_BACKUP_PATH=
MAZ_LLAMACPP_THREADS=6
MAZ_LLAMACPP_PARALLEL=1
MAZ_LLAMACPP_TTL_SECONDS=300
MAZ_DEFAULT_ROUTE=local

# Kept only for migration/visibility. MAZ Core inference does not depend on Ollama.
MAZ_OLLAMA_URL=http://127.0.0.1:11434
MAZ_OLLAMA_MODEL=qwen3.5:4b
MAZ_OLLAMA_BACKUP_MODEL=qwen3:4b-q4_K_M
MAZ_LOCAL_MODEL_POLICY=auto

# Optional cloud route. Empty key means disabled.
MAZ_CLOUD_URL=https://openrouter.ai/api/v1
MAZ_CLOUD_KEY=
MAZ_CLOUD_MODEL=anthropic/claude-3.5-haiku

MAZ_CORE_ENABLED=true
MAZ_PROJECT_ROOTS=
MAZ_OBSIDIAN_ROOT=
MAZ_CARDPUTER_URL=http://mazpocket.local
MAZ_WEB_ORIGINS=https://mazos-site.vercel.app,http://localhost:3000,http://127.0.0.1:3000

MAZ_BRIDGE_ENABLED=false
MAZ_BRIDGE_REPO=manazoid4/maz-pocket
MAZ_GITHUB_TOKEN=
MAZ_BRIDGE_POLL_SECONDS=15

MAZ_MAX_UPLOAD_MB=12
MAZ_MAX_AUDIO_SECONDS=900
MAZ_SESSION_TTL_MINUTES=120
MAZ_MAX_TURNS=24

MAZ_NUDGE_URL=http://127.0.0.1:47831
MAZ_NUDGE_TOKEN=
MAZ_NUDGE_TOKEN_FILE=~/.agent-nudge/control-plane.key
MAZ_NUDGE_CROSS_SYNC_DAYS=3

MAZ_DEVICE_PORT=
MAZ_DEVICE_BAUD=115200
MAZ_DEVICE_VID=12346
MAZ_DEVICE_PID=4097

MAZ_TTS_ENABLED=false
MAZ_TTS_RATE=180
