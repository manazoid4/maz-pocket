# MAZ Core v0.7 configuration. Copy to host/.env and edit, or run install-core.ps1.
MAZ_TOKEN=change-me-before-first-run
MAZ_BIND=0.0.0.0
MAZ_PORT=8787

# Speech to text
MAZ_WHISPER_MODEL=base.en
MAZ_WHISPER_DEVICE=cpu
MAZ_WHISPER_COMPUTE=int8

# Local-first AI. LOCAL never uses cloud. AUTO tries both locals before cloud.
# MAZ_LOCAL_ENGINE picks which local runtime answers: ollama or llamacpp.
MAZ_LOCAL_ENGINE=ollama

# llama.cpp engine. Start the server first with host\start-llamacpp.ps1; MAZ
# Core only talks to it. The model name is a label the request carries, since
# llama-server serves the single model it was launched with. A second server on
# another port can act as backup.
MAZ_LLAMACPP_URL=http://127.0.0.1:8080
MAZ_LLAMACPP_MODEL=local
MAZ_LLAMACPP_BACKUP_URL=
MAZ_LLAMACPP_BACKUP_MODEL=
# Read by start-llamacpp.ps1 only, not by MAZ Core itself.
MAZ_LLAMACPP_SERVER_EXE=
MAZ_LLAMACPP_MODEL_PATH=

# Ollama engine.
MAZ_OLLAMA_URL=http://127.0.0.1:11434
MAZ_OLLAMA_MODEL=lfm2.5-8b-a1b-gpu:latest
MAZ_OLLAMA_BACKUP_MODEL=qwen3.5:4b
MAZ_LOCAL_MODEL_POLICY=auto
# SMART = 4K ordinary context + 5m warm model; SAVE unloads immediately;
# FAST keeps the local model warm for 30m. Context grows only when needed.
MAZ_AI_PROFILE=smart
MAZ_DEFAULT_ROUTE=local

# Explicit Cardputer MAZLATEST route. This endpoint is deliberately restricted
# to loopback by MAZ Core; no router credential is stored on the Cardputer.
MAZ_MAZLATEST_URL=http://localhost:20128/v1
MAZ_MAZLATEST_KEY=
MAZ_MAZLATEST_MODEL=MazLatest
MAZ_BUILD_ID=dev

# Cloud fallback, used by AUTO after the local chain and by CLOUD directly.
# Any OpenAI-compatible endpoint works. MAZLATEST above is a separate explicit
# route and never silently falls back to this provider.
MAZ_CLOUD_URL=https://openrouter.ai/api/v1
MAZ_CLOUD_KEY=
MAZ_CLOUD_MODEL=anthropic/claude-3.5-haiku

# MAZ Core project/memory roots. Separate multiple project roots with semicolons.
MAZ_CORE_ENABLED=true
MAZ_PROJECT_ROOTS=
MAZ_OBSIDIAN_ROOT=
MAZ_CARDPUTER_URL=http://mazpocket.local
MAZ_WEB_ORIGINS=https://mazos-site.vercel.app,http://localhost:3000,http://127.0.0.1:3000

# Optional private GitHub bridge used by ChatGPT -> GitHub -> this PC.
MAZ_BRIDGE_ENABLED=false
MAZ_BRIDGE_REPO=manazoid4/maz-pocket
MAZ_GITHUB_TOKEN=
MAZ_BRIDGE_POLL_SECONDS=15

# Limits
MAZ_MAX_UPLOAD_MB=12
MAZ_MAX_AUDIO_SECONDS=900
MAZ_SESSION_TTL_MINUTES=120
MAZ_MAX_TURNS=24

# Agent Nudge
MAZ_NUDGE_URL=http://127.0.0.1:47831
MAZ_NUDGE_TOKEN=
MAZ_NUDGE_TOKEN_FILE=~/.agent-nudge/control-plane.key
MAZ_NUDGE_CROSS_SYNC_DAYS=3

# Cardputer serial assurance
MAZ_DEVICE_PORT=
MAZ_DEVICE_BAUD=115200
MAZ_DEVICE_VID=12346
MAZ_DEVICE_PID=4097

# Spoken replies
MAZ_TTS_ENABLED=true
MAZ_TTS_RATE=180
