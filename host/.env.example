# MAZ Host configuration. Copy to host/.env and edit.
# Secrets live here, on the laptop. They are never sent to the Cardputer.

# --- Security ---------------------------------------------------------------
# Shared token. The Cardputer sends it as `Authorization: Bearer <token>`.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(24))"
MAZ_TOKEN=change-me-before-first-run

# LAN-first. 0.0.0.0 binds every interface so the Cardputer can reach you;
# only do that behind a trusted router, never on public Wi-Fi.
MAZ_BIND=0.0.0.0
MAZ_PORT=8787

# --- Speech to text ---------------------------------------------------------
# tiny.en / base.en / small.en / medium.en / large-v3
# base.en is the sweet spot on CPU: roughly real-time, good enough for dictation.
MAZ_WHISPER_MODEL=base.en
MAZ_WHISPER_DEVICE=cpu
MAZ_WHISPER_COMPUTE=int8

# --- Local model (Ollama) ---------------------------------------------------
MAZ_OLLAMA_URL=http://127.0.0.1:11434
MAZ_OLLAMA_MODEL=gemma3:1b

# --- Cloud model (optional, any OpenAI-compatible endpoint) -----------------
# OpenRouter example. Leave MAZ_CLOUD_KEY empty to disable the cloud route.
MAZ_CLOUD_URL=https://openrouter.ai/api/v1
MAZ_CLOUD_KEY=
MAZ_CLOUD_MODEL=anthropic/claude-3.5-haiku

# --- Routing ----------------------------------------------------------------
# auto  = local if Ollama answers, else cloud
# local = Ollama only, fail loudly if it is down
# cloud = cloud only
MAZ_DEFAULT_ROUTE=auto

# --- Limits (a small device should not be able to wedge the laptop) ---------
MAZ_MAX_UPLOAD_MB=12
MAZ_MAX_AUDIO_SECONDS=900
MAZ_SESSION_TTL_MINUTES=120
MAZ_MAX_TURNS=24

# --- Agent Nudge (optional) -------------------------------------------------
# Loopback daemon only. The Cardputer never receives this credential.
MAZ_NUDGE_URL=http://127.0.0.1:47831
MAZ_NUDGE_TOKEN=
# Defaults to Agent Nudge's owner-only local credential; override only when needed.
MAZ_NUDGE_TOKEN_FILE=~/.agent-nudge/control-plane.key
MAZ_NUDGE_CROSS_SYNC_DAYS=3

# --- Cardputer serial assurance --------------------------------------------
# Leave the port blank to follow the ESP32-S3 by USB VID/PID across reconnects.
# Monitoring starts only when requested, so it never steals the port from Launcher.
MAZ_DEVICE_PORT=
MAZ_DEVICE_BAUD=115200
MAZ_DEVICE_VID=12346
MAZ_DEVICE_PID=4097

# --- Optional text to speech ------------------------------------------------
# Off by default: it is a nice-to-have and must never delay a text answer.
MAZ_TTS_ENABLED=false
MAZ_TTS_RATE=185
